worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /tmp/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    keepalive_timeout 65;
    client_max_body_size 50m;

    # temp paths writable by non-root
    client_body_temp_path /tmp/client_body;
    proxy_temp_path       /tmp/proxy_temp;
    fastcgi_temp_path     /tmp/fastcgi_temp;
    uwsgi_temp_path       /tmp/uwsgi_temp;
    scgi_temp_path        /tmp/scgi_temp;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # Render terminates TLS in front of nginx, so $scheme is http. Use the
    # original client proto when present so redirects and cookies stay HTTPS.
    map $http_x_forwarded_proto $fwd_proto {
        default $http_x_forwarded_proto;
        ''      $scheme;
    }

    server {
        listen       ${PORT};
        server_name  _;
        absolute_redirect off;
        port_in_redirect off;

        # Home-screen / favicon / manifest assets at site root (iOS requests these)
        location = /apple-touch-icon.png {
            alias /app/static-icons/apple-touch-icon.png;
            add_header Cache-Control "public, max-age=86400";
            default_type image/png;
        }
        location = /apple-touch-icon-precomposed.png {
            alias /app/static-icons/apple-touch-icon-precomposed.png;
            add_header Cache-Control "public, max-age=86400";
            default_type image/png;
        }
        location = /apple-touch-icon-120x120.png {
            alias /app/static-icons/apple-touch-icon-120x120.png;
            add_header Cache-Control "public, max-age=86400";
            default_type image/png;
        }
        location = /favicon.ico {
            alias /app/static-icons/favicon.ico;
            add_header Cache-Control "public, max-age=86400";
            default_type image/x-icon;
        }
        location = /favicon.png {
            alias /app/static-icons/favicon.png;
            add_header Cache-Control "public, max-age=86400";
            default_type image/png;
        }
        location = /icon-192.png {
            alias /app/static-icons/icon-192.png;
            add_header Cache-Control "public, max-age=86400";
            default_type image/png;
        }
        location = /icon-512.png {
            alias /app/static-icons/icon-512.png;
            add_header Cache-Control "public, max-age=86400";
            default_type image/png;
        }
        location = /manifest.webmanifest {
            alias /app/static-icons/manifest.webmanifest;
            add_header Cache-Control "public, max-age=86400";
            default_type application/manifest+json;
        }
        location = /manifest.json {
            alias /app/static-icons/manifest.webmanifest;
            add_header Cache-Control "public, max-age=86400";
            default_type application/manifest+json;
        }
        location = /site.webmanifest {
            alias /app/static-icons/manifest.webmanifest;
            add_header Cache-Control "public, max-age=86400";
            default_type application/manifest+json;
        }

        # Native HTML login / logout (real form POST + 303 for iOS Keychain)
        location = /login {
            proxy_pass http://127.0.0.1:8502;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $fwd_proto;
            proxy_set_header Cookie $http_cookie;
        }
        location = /logout {
            proxy_pass http://127.0.0.1:8502;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $fwd_proto;
            proxy_set_header Cookie $http_cookie;
        }

        # Streamlit websocket
        location /_stcore/stream {
            proxy_pass http://127.0.0.1:8501;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $fwd_proto;
            proxy_read_timeout 86400;
            proxy_send_timeout 86400;
        }

        # Health check and other Streamlit _stcore paths (no login redirect)
        location /_stcore/ {
            proxy_pass http://127.0.0.1:8501;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $fwd_proto;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 86400;
            proxy_send_timeout 86400;
        }

        # Unauthenticated document requests for / go to the HTML login page.
        # A present cookie (valid or not) is passed through so Streamlit can
        # restore a session or send the member to /logout.
        location = / {
            if ($cookie_dd_stay = "") {
                return 302 /login;
            }
            proxy_pass http://127.0.0.1:8501;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $fwd_proto;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 86400;
            proxy_send_timeout 86400;
            proxy_buffering on;
            proxy_set_header Accept-Encoding "";
            sub_filter_once on;
            sub_filter_types text/html;
            sub_filter '</head>' '<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=20261116icon"><link rel="apple-touch-icon-precomposed" href="/apple-touch-icon-precomposed.png?v=20261116icon"><link rel="icon" type="image/png" href="/favicon.png?v=20261116icon"><link rel="manifest" href="/manifest.webmanifest"><meta name="apple-mobile-web-app-title" content="DD Hunt Tracker"><meta name="application-name" content="DD Hunt Tracker"><meta name="apple-mobile-web-app-capable" content="yes"><meta name="mobile-web-app-capable" content="yes"><meta name="theme-color" content="#1B3A2A"></head>';
        }

        location / {
            proxy_pass http://127.0.0.1:8501;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $fwd_proto;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 86400;
            proxy_send_timeout 86400;
            # Buffering on so sub_filter can rewrite the HTML head. Websockets
            # are handled in /_stcore/stream and are unaffected.
            proxy_buffering on;
            # Streamlit gzips HTML; sub_filter only works on uncompressed text
            proxy_set_header Accept-Encoding "";
            sub_filter_once on;
            sub_filter_types text/html;
            sub_filter '</head>' '<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=20261116icon"><link rel="apple-touch-icon-precomposed" href="/apple-touch-icon-precomposed.png?v=20261116icon"><link rel="icon" type="image/png" href="/favicon.png?v=20261116icon"><link rel="manifest" href="/manifest.webmanifest"><meta name="apple-mobile-web-app-title" content="DD Hunt Tracker"><meta name="application-name" content="DD Hunt Tracker"><meta name="apple-mobile-web-app-capable" content="yes"><meta name="mobile-web-app-capable" content="yes"><meta name="theme-color" content="#1B3A2A"></head>';
        }
    }
}
